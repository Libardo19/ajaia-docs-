generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShareRole {
  VIEWER
  EDITOR
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String
  color     String          @default("#2563eb")
  documents Document[]      @relation("OwnedDocuments")
  shares    DocumentShare[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("users")
}

model Document {
  id          String          @id @default(cuid())
  title       String          @db.VarChar(200)
  /// Tiptap/ProseMirror JSON document. Stored as JSON (not HTML) so structure round-trips losslessly.
  content     Json
  /// Optimistic-concurrency counter. Every successful write increments it.
  version     Int             @default(1)
  ownerId     String          @map("owner_id")
  owner       User            @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: Cascade)
  updatedById String?         @map("updated_by_id")
  shares      DocumentShare[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([ownerId, updatedAt])
  @@map("documents")
}

model DocumentShare {
  documentId String    @map("document_id")
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ShareRole
  createdAt  DateTime  @default(now()) @map("created_at")

  @@id([documentId, userId])
  @@index([userId])
  @@map("document_shares")
}
