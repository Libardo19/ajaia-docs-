{
  "name": "ajaia-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:local": "pglite-server --db=./.pglite --port=5440 --max-connections=10"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "happy-dom": "^20.14.6",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
